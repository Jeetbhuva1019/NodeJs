<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Articles</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <%- include('navbar') %>
    <h1>My Articles</h1>
    <ul>
        <% articles.forEach(article => { %>
            <li><a href="/articles/<%= article.id %>"><%= article.title %></a></li>
        <% }) %>
    </ul>
</body>
</html>
